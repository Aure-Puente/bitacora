rules_version = '2';

// Reglas de seguridad de Bitácora.
// Idea: solo los integrantes de un viaje (trips/{id}.memberIds) pueden leer y escribir sus datos.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function isMember(tripId) {
      return signedIn() && request.auth.uid in get(tripPath(tripId)).data.memberIds;
    }

    // Perfil de usuario: solo el dueño.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Códigos de invitación: se puede consultar uno exacto (get), pero no listarlos todos.
    match /tripCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /trips/{tripId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      allow update: if signedIn() && (
        // El creador edita el viaje (sin cambiar el dueño ni el código)
        (
          request.auth.uid == resource.data.ownerId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.code == resource.data.code
        )
        ||
        // Alguien se une con el código: solo se agrega a sí mismo a memberIds
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        )
        ||
        // Cualquier integrante puede hacer que la salida siga a un vuelo de Reservas...
        (
          request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['departureAt', 'departureBookingId'])
          && (
            (
              request.resource.data.departureBookingId == null
              && request.resource.data.departureAt == resource.data.departureAt
            )
            ||
            (
              request.resource.data.departureBookingId is string
              && request.resource.data.departureAt is timestamp
              && request.resource.data.departureAt < resource.data.returnAt
              && getAfter(/databases/$(database)/documents/trips/$(tripId)/bookings/$(request.resource.data.departureBookingId)).data.type == 'vuelo'
            )
          )
        )
        ||
        // ...y cargar el link al álbum de Drive o Google Photos
        (
          request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['albumUrl'])
          && request.resource.data.albumUrl is string
          && request.resource.data.albumUrl.size() <= 1010
        )
      );

      allow delete: if false;

      // Integrantes (perfil visible dentro del viaje)
      match /members/{memberId} {
        allow read: if isMember(tripId);
        allow create: if signedIn()
          && request.auth.uid == memberId
          && request.auth.uid in getAfter(tripPath(tripId)).data.memberIds;
        allow update: if signedIn() && request.auth.uid == memberId;
        allow delete: if false;
      }

      // Gastos y pagos para saldar: cualquier integrante
      match /expenses/{expenseId} {
        allow read, write: if isMember(tripId);
      }
      match /settlements/{settlementId} {
        allow read, write: if isMember(tripId);
      }

      // Planes de cuotas (ej: los vuelos que pagó Valentín)
      match /plans/{planId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId) && request.resource.data.createdBy == request.auth.uid;

        // Solo quien cobra puede editarlo, y sin cambiar quién cobra: así un deudor
        // no puede ponerse como acreedor y confirmar sus propias cuotas.
        allow update: if isMember(tripId)
          && resource.data.creditorId == request.auth.uid
          && request.resource.data.creditorId == resource.data.creditorId
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isMember(tripId)
          && (resource.data.creditorId == request.auth.uid || resource.data.createdBy == request.auth.uid);

        match /payments/{paymentId} {
          allow read: if isMember(tripId);

          // El deudor avisa que pagó una cuota: queda "pending"
          allow create: if isMember(tripId)
            && request.resource.data.debtorId == request.auth.uid
            && request.resource.data.status == 'pending';

          // Solo quien cobró (creditorId) puede confirmarla
          allow update: if isMember(tripId)
            && get(/databases/$(database)/documents/trips/$(tripId)/plans/$(planId)).data.creditorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt']);

          // Rechazar (acreedor) o deshacer una pendiente (deudor)
          allow delete: if isMember(tripId) && (
            get(/databases/$(database)/documents/trips/$(tripId)/plans/$(planId)).data.creditorId == request.auth.uid
            || get(/databases/$(database)/documents/trips/$(tripId)/plans/$(planId)).data.createdBy == request.auth.uid
            || (resource.data.debtorId == request.auth.uid && resource.data.status == 'pending')
          );
        }
      }

      // ----- Plan del viaje (Etapa 1) -----

      // Quien crea un documento queda registrado, y después no se puede cambiar.
      function createdByMe() {
        return request.resource.data.createdBy == request.auth.uid;
      }
      function sameCreator() {
        return request.resource.data.createdBy == resource.data.createdBy;
      }
      function validText(text, max) {
        return text is string && text.size() > 0 && text.size() <= max;
      }

      // Itinerario e ideas (day = null): los edita cualquier integrante
      match /activities/{activityId} {
        function validActivity(d) {
          return validText(d.title, 120)
            && (d.day == null || (d.day is string && d.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
            && (d.time == null || (d.time is string && d.time.matches('[0-9]{2}:[0-9]{2}')))
            && d.place is string && d.place.size() <= 200
            && d.mapsUrl is string && d.mapsUrl.size() <= 1010
            && d.notes is string && d.notes.size() <= 2000
            && d.status in ['idea', 'reservado', 'hecho']
            && d.order is number;
        }
        allow read, delete: if isMember(tripId);
        allow create: if isMember(tripId) && createdByMe() && validActivity(request.resource.data);
        allow update: if isMember(tripId) && sameCreator() && validActivity(request.resource.data);
      }

      // Votaciones: votes = { uid: idDeOpcion }
      match /polls/{pollId} {
        allow read: if isMember(tripId);

        allow create: if isMember(tripId) && createdByMe()
          && validText(request.resource.data.question, 200)
          && request.resource.data.options is list
          && request.resource.data.optionIds is list
          && request.resource.data.optionIds.size() >= 2
          && request.resource.data.optionIds.size() <= 10
          && request.resource.data.options.size() == request.resource.data.optionIds.size()
          && request.resource.data.status == 'open'
          && request.resource.data.votes == {};

        allow update: if isMember(tripId) && resource.data.status == 'open' && (
          // Votar o cambiar el voto: solo el propio y por una opción que exista
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
            && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid])
            && request.auth.uid in request.resource.data.votes
            && request.resource.data.votes[request.auth.uid] in resource.data.optionIds
          )
          ||
          // Cerrar: solo quien la creó
          (
            resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt'])
            && request.resource.data.status == 'closed'
          )
        );

        allow delete: if isMember(tripId) && resource.data.createdBy == request.auth.uid;
      }

      // Equipaje: todos ven todo; la lista personal solo la cambia su dueño
      match /checklistItems/{itemId} {
        function canEdit(d) {
          return (d.scope == 'shared' && d.ownerId == null)
            || (d.scope == 'personal' && d.ownerId == request.auth.uid);
        }
        function validItem(d) {
          return validText(d.text, 100) && d.done is bool;
        }
        allow read: if isMember(tripId);
        allow create: if isMember(tripId) && createdByMe()
          && canEdit(request.resource.data) && validItem(request.resource.data);
        allow update: if isMember(tripId) && sameCreator()
          && canEdit(resource.data) && validItem(request.resource.data)
          && request.resource.data.scope == resource.data.scope
          && request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if isMember(tripId) && canEdit(resource.data);
      }

      // Tareas previas: las edita cualquier integrante
      match /tasks/{taskId} {
        function validTask(d) {
          return validText(d.title, 200) && d.done is bool
            && (d.assigneeId == null || d.assigneeId in get(tripPath(tripId)).data.memberIds);
        }
        allow read, delete: if isMember(tripId);
        allow create: if isMember(tripId) && createdByMe() && validTask(request.resource.data);
        allow update: if isMember(tripId) && sameCreator() && validTask(request.resource.data);
      }

      // ----- Reservas y contactos (Etapa 2a): los edita cualquier integrante -----

      match /bookings/{bookingId} {
        function validFlight(f) {
          return f.keys().hasOnly(['airline', 'number', 'terminal', 'gate'])
            && f.airline is string && f.airline.size() <= 60
            && f.number is string && f.number.size() <= 12
            && f.terminal is string && f.terminal.size() <= 12
            && f.gate is string && f.gate.size() <= 12;
        }
        function validBooking(d) {
          return d.type in ['vuelo', 'alojamiento', 'excursion', 'auto', 'otro']
            && validText(d.title, 120)
            && d.code is string && d.code.size() <= 60
            && d.day is string && d.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && (d.time == null || (d.time is string && d.time.matches('[0-9]{2}:[0-9]{2}')))
            && d.address is string && d.address.size() <= 200
            && d.mapsUrl is string && d.mapsUrl.size() <= 1010
            && d.notes is string && d.notes.size() <= 2000
            && (d.type == 'vuelo' ? validFlight(d.flight) : d.flight == null);
        }
        allow read, delete: if isMember(tripId);
        allow create: if isMember(tripId) && createdByMe() && validBooking(request.resource.data);
        allow update: if isMember(tripId) && sameCreator() && validBooking(request.resource.data);
      }

      // ----- Archivos (Etapa 2b): los datos; el contenido está en Storage (storage.rules) -----
      match /files/{fileId} {
        function fileBase(d) {
          return 'trips/' + tripId + '/' + d.visibility + '/' + request.auth.uid + '/' + fileId;
        }
        function validFile(d) {
          return validText(d.name, 120)
            && d.contentType in ['image/jpeg', 'application/pdf']
            && d.size is int && d.size > 0 && d.size <= 10 * 1024 * 1024
            && d.kind in ['documento', 'ticket', 'album']
            && (d.visibility == 'group' || (d.visibility == 'private' && d.kind == 'documento'))
            // La ruta tiene que ser la carpeta propia y coincidir con la visibilidad
            && d.path == fileBase(d) + (d.contentType == 'application/pdf' ? '.pdf' : '.jpg')
            && (d.thumbPath == null || d.thumbPath == fileBase(d) + '_mini.jpg')
            && (d.bookingId == null || d.bookingId is string);
        }
        allow read: if isMember(tripId)
          && (resource.data.visibility == 'group' || resource.data.ownerId == request.auth.uid);
        allow create: if isMember(tripId)
          && request.resource.data.ownerId == request.auth.uid
          && validFile(request.resource.data);
        // Después solo se cambian el nombre y la reserva
        allow update: if isMember(tripId)
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bookingId'])
          && validFile(request.resource.data);
        allow delete: if isMember(tripId) && resource.data.ownerId == request.auth.uid;
      }

      match /contacts/{contactId} {
        function validContact(d) {
          return validText(d.name, 100) && validText(d.phone, 40)
            && d.note is string && d.note.size() <= 500;
        }
        allow read, delete: if isMember(tripId);
        allow create: if isMember(tripId) && createdByMe() && validContact(request.resource.data);
        allow update: if isMember(tripId) && sameCreator() && validContact(request.resource.data);
      }
    }
  }
}
